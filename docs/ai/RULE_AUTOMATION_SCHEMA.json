{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://battleaxe177.github.io/Battle-Axe-Design-Studio/contracts/rule-automation-1.0.schema.json",
  "title": "Battle Axe Structured Rule Automation 1.0",
  "type": "object",
  "required": ["version", "timing", "actions", "persistence"],
  "properties": {
    "version": {"const": "1.0"},
    "timing": {"enum": ["setup", "turn-start", "side-turn-start", "after-action"]},
    "affectedSideId": {"enum": ["sideA", "sideB"]},
    "affectedCommandId": {"type": "string", "minLength": 1},
    "initialState": {"type": "string"},
    "condition": {"type": ["object", "null"]},
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": ["type", "sideId"],
            "properties": {
              "type": {"const": "set-turn-one-initiative"},
              "sideId": {"enum": ["sideA", "sideB"]}
            },
            "additionalProperties": false
          }
        ]
      }
    },
    "persistence": {"enum": ["once", "while-condition", "permanent"]}
  },
  "additionalProperties": false
}
